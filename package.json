{
  "name": "aeris",
  "private": true,
  "scripts": {
    "dev": "concurrently -n bot,api,dashboard -c blue,green,magenta \"pnpm --filter @aeris/bot dev\" \"pnpm --filter @aeris/api dev\" \"pnpm --filter @aeris/dashboard dev\"",
    "build": "pnpm --filter @aeris/shared build && concurrently pnpm:build:*",
    "build:bot": "pnpm --filter @aeris/bot build",
    "build:api": "pnpm --filter @aeris/api build",
    "build:dashboard": "pnpm --filter @aeris/dashboard build",
    "db:generate": "pnpm --filter @aeris/shared db:generate",
    "db:push": "pnpm --filter @aeris/shared db:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
