generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id          String   @id
  name        String?
  icon        String?
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id          String   @id
  username    String?
  displayName String?
  avatar      String?
  createdAt   DateTime @default(now())
}

model GuildMember {
  id       String   @id
  guildId  String
  userId   String
  joinedAt DateTime? @default(now())
  role     String?
}

model AutomodSettings {
  id           String   @id
  guildId      String   @unique
  wordFilters  String   @default("[]")
  linkFilters  String   @default("[]")
  spamEnabled  Boolean  @default(true)
  raidEnabled  Boolean  @default(true)
  maxLinks     Int      @default(5)
  maxEmotes    Int      @default(10)
  blockInvites Boolean  @default(true)
}

model LevelingSettings {
  id             String   @id
  guildId        String   @unique
  enabled        Boolean  @default(true)
  xpMessage      String   @default("Your message earned you **{xp}** XP!")
  levelUpMessage String   @default("🎉 **{user}** just leveled up to **Level {level}**!")
  autoRole       String?
}

model LevelingData {
  id      String   @id
  guildId String
  userId  String
  level   Int      @default(1)
  xp      Int      @default(0)
  totalXp Int      @default(0)

  @@unique([guildId, userId])
}

model EconomySettings {
  id          String   @id
  guildId     String   @unique
  enabled     Boolean  @default(true)
  dailyAmount Int      @default(500)
  minCash     Int      @default(0)
}

model EconomyUser {
  id        String   @id
  guildId   String
  userId    String
  cash      Int      @default(0)
  bank      Int      @default(0)
  lastDaily DateTime?

  @@unique([guildId, userId])
}

model EconomyInventory {
  id       String   @id
  guildId  String
  userId   String
  itemId   String
  quantity Int      @default(1)

  @@unique([guildId, userId, itemId])
}

model TicketConfig {
  id                 String   @id
  guildId            String   @unique
  channelId          String?
  categoryId         String?
  transcriptEnabled  Boolean  @default(true)
  closable           Boolean  @default(true)
}

model Ticket {
  id             String   @id
  guildId        String
  channelId      String
  openerId       String
  subject        String?
  createdAt      DateTime @default(now())
  closedAt       DateTime?
  transcriptUrl  String?
}

model WelcomeConfig {
  id                String   @id
  guildId           String   @unique
  channelId         String?
  message           String   @default("Welcome {user} to {server}! 👋")
  dmEnabled         Boolean  @default(false)
  dmMessage         String   @default("Welcome to {server}, {user}!")
  goodbyeChannelId  String?
  goodbyeMessage    String   @default("Goodbye {user}!")
  autoRoleId        String?
}

model MusicQueue {
  id         String   @id
  guildId    String   @unique
  channelId  String?
  nowPlaying String?
  queue      String   @default("[]")
}

model ModerationLog {
  id           String   @id
  guildId      String
  userId       String
  action       String
  reason       String?
  moderatorId  String?
  createdAt    DateTime @default(now())
}

model EconomyShopItem {
  id          String   @id
  guildId     String
  name        String
  description String?
  price       Int
  category    String   @default("general")
  icon        String?

  @@unique([guildId, id])
}
